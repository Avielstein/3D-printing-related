#!/bin/bash
# Jog the printer. Requires the session script to be running.
#
# Usage:
#   jog left|right N    - move X by N mm (default 5)
#   jog back|fwd N      - move Y +/- N mm
#   jog up|down N       - move Z +/- N mm
#   jog home            - G28 home all
#   jog where           - M114 current position
#   jog endstops        - M119 endstop / probe status
#   jog send "G..."     - send raw gcode
#   jog stop            - M410 quickstop (abort moves)
#   jog estop           - M112 EMERGENCY STOP (needs power cycle)
#   jog quit            - tell session to exit cleanly

CMD=/tmp/lulzbot_cmd
DIR=$1
MM=${2:-5}

if [ ! -p "$CMD" ] && [ ! -f "$CMD" ]; then
    echo "Command file $CMD missing. Is session.py running?"
    exit 1
fi

case "$DIR" in
    left)     echo -e "G91\nG1 X-$MM F2000\nG90"   >> "$CMD" ;;
    right)    echo -e "G91\nG1 X$MM F2000\nG90"    >> "$CMD" ;;
    fwd|forward) echo -e "G91\nG1 Y-$MM F2000\nG90" >> "$CMD" ;;
    back)     echo -e "G91\nG1 Y$MM F2000\nG90"    >> "$CMD" ;;
    up)       echo -e "G91\nG1 Z$MM F600\nG90"     >> "$CMD" ;;
    down)     echo -e "G91\nG1 Z-$MM F300\nG90"    >> "$CMD" ;;
    home)     echo "G28"   >> "$CMD" ;;
    where)    echo "M114"  >> "$CMD" ;;
    endstops) echo "M119"  >> "$CMD" ;;
    stop)     echo "M410"  >> "$CMD" ;;
    estop)    echo "M112"  >> "$CMD" ;;
    quit)     echo "EXIT"  >> "$CMD" ;;
    send)     echo "$2"    >> "$CMD" ;;
    *)
        echo "Usage: $0 {left|right|fwd|back|up|down} [mm]"
        echo "       $0 home|where|endstops|stop|estop|quit"
        echo "       $0 send \"GCODE\""
        exit 1
        ;;
esac
echo "queued: $DIR ${MM:-}"
